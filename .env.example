# Hamed AI — environment template (NEVER commit real secrets)
# Required for standalone Telegram runtime
OPENAI_API_KEY=
TELEGRAM_BOT_TOKEN=

# Optional AI brains. Hamed runs with OpenAI alone and uses any additional
# configured providers as future routing/fallback targets.
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=
KIMI_API_KEY=
GEMINI_API_KEY=
MISTRAL_API_KEY=
QWEN_API_KEY=
GROK_API_KEY=
OPENROUTER_API_KEY=

# Optional model override
OPENAI_MODEL=gpt-5

# Optional Telegram settings
TELEGRAM_CHAT_ID=

# Optional persistence. If omitted, Hamed uses its local SQLite/default path.
DATABASE_URL=

# Optional runtime settings
APP_ENV=development
LOG_LEVEL=INFO

# Optional bounded autonomous commercial authority
HAMED_AUTONOMOUS_MODE=false
HAMED_MAX_PURCHASE_VALUE=0
HAMED_MAX_PAYMENT_VALUE=0
HAMED_MAX_DISCOUNT_PERCENT=20

# Optional Twilio voice integration — leave unset to disable
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Optional Paymob payment integration — leave unset to disable
PAYMOB_API_KEY=
PAYMOB_PUBLIC_KEY=
PAYMOB_HMAC_SECRET=
PAYMOB_INTEGRATION_ID=
PAYMOB_BASE_URL=https://accept.paymob.com
