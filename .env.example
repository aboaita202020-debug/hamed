# AI provider
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Persistence (SQLite default for local development)
DATABASE_URL=sqlite:///hamed.db

# Runtime
APP_ENV=development
LOG_LEVEL=INFO

# Bounded autonomous commercial authority
# Enable only after configuring the financial limits below.
HAMED_AUTONOMOUS_MODE=false
HAMED_MAX_PURCHASE_VALUE=0
HAMED_MAX_PAYMENT_VALUE=0
HAMED_MAX_DISCOUNT_PERCENT=20
