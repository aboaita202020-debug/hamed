# Hamed AI — environment template (NEVER commit real secrets)
# Required for standalone Telegram runtime
OPENAI_API_KEY=
TELEGRAM_BOT_TOKEN=

# Optional AI brains — configure any combination; Hamed automatically routes/falls back.
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=
KIMI_API_KEY=
GEMINI_API_KEY=
MISTRAL_API_KEY=
QWEN_API_KEY=
XAI_API_KEY=
GROK_API_KEY=
LLAMA_API_KEY=
OPENROUTER_API_KEY=

# Optional model overrides
OPENAI_MODEL=gpt-5
ANTHROPIC_MODEL=claude-3-5-sonnet-latest
DEEPSEEK_MODEL=deepseek-chat
KIMI_MODEL=kimi-k2-0905-preview
GEMINI_MODEL=gemini-2.5-flash
MISTRAL_MODEL=mistral-small-latest
QWEN_MODEL=qwen-plus
XAI_MODEL=grok-3-mini
GROK_MODEL=grok-3-mini
LLAMA_MODEL=llama-4-scout-17b-16e-instruct
OPENROUTER_MODEL=openai/gpt-4o-mini

# Optional provider base URLs (useful for proxies/self-hosted OpenAI-compatible gateways)
DEEPSEEK_API_KEY_BASE_URL=
KIMI_API_KEY_BASE_URL=
GEMINI_API_KEY_BASE_URL=
MISTRAL_API_KEY_BASE_URL=
QWEN_API_KEY_BASE_URL=
XAI_API_KEY_BASE_URL=
LLAMA_API_KEY_BASE_URL=
OPENROUTER_API_KEY_BASE_URL=

# Optional Telegram settings
TELEGRAM_CHAT_ID=
HAMED_TELEGRAM_POLLING=true

# Optional persistence. If omitted, Hamed uses its local SQLite/default path.
DATABASE_URL=

# Commercial opportunity hunter
HAMED_OPPORTUNITY_HUNTER=true
HAMED_OPPORTUNITY_INTERVAL=1800

# Optional business communication identifier; never put credentials here
HAMED_WHATSAPP_NUMBER=

# Vodafone Cash merchant wallets (comma-separated). Never store wallet PIN/OTP.
HAMED_VODAFONE_CASH_WALLETS=

# Optional runtime settings
APP_ENV=development
LOG_LEVEL=INFO

# Optional bounded autonomous commercial authority
HAMED_AUTONOMOUS_MODE=false
HAMED_MAX_PURCHASE_VALUE=0
HAMED_MAX_PAYMENT_VALUE=0
HAMED_MAX_DISCOUNT_PERCENT=20

# Optional Twilio voice integration — leave unset to disable
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Optional Paymob payment integration — leave unset to disable
PAYMOB_API_KEY=
PAYMOB_PUBLIC_KEY=
PAYMOB_HMAC_SECRET=
PAYMOB_INTEGRATION_ID=
PAYMOB_BASE_URL=https://accept.paymob.com
