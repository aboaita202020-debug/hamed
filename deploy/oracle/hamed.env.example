# Copy to /etc/hamed/hamed.env on the Oracle VM. Never commit real values.
APP_ENV=production
LOG_LEVEL=INFO

OPENAI_API_KEY=
OPENAI_MODEL=

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
PUBLIC_BASE_URL=

# Free-first controls
PAID_SERVICES_ENABLED=false
VOICE_ENABLED=false
DAILY_CALL_LIMIT=0
MONTHLY_SPEND_LIMIT_USD=0
