# Hamed Free-First runtime configuration
# Put real secrets in GitHub Actions Secrets or the deployment environment.
HAMED_AI_MODE=free_first
HAMED_MAX_RETRIES=3
HAMED_ENABLE_AUTONOMOUS_RESEARCH=true
HAMED_ENABLE_CONTINUOUS_LEARNING=true
HAMED_ENABLE_DYNAMIC_AGENTS=true
HAMED_TELEGRAM_ENABLED=true

# Optional providers. Leave empty when unavailable.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
KIMI_API_KEY=
TELEGRAM_BOT_TOKEN=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Never put passwords, bot tokens, API keys, OAuth secrets, or payment credentials in this file or Git.
